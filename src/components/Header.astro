---
import { getLocaleFromUrl, t, locales, localeNames, getLocalePath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const i = t(locale);
const currentPath = Astro.url.pathname.replace(/^\/(zh-TW|zh-CN)(\/|$)/, '/');
---

<header class="sticky top-0 z-50 bg-[#070A12]/80 backdrop-blur-xl border-b border-white/5">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo & Brand -->
    <a href={getLocalePath(locale, '')} class="flex items-center gap-3 group">
      <img src="/vililt-logo.png" alt="viLilt" class="w-10 h-10 rounded-xl shadow-[0_0_25px_rgba(139,85,250,0.5)] border border-white/10 group-hover:scale-105 transition-transform" />
      <div class="flex flex-col text-left">
        <span class="text-xl font-extrabold tracking-tight text-white flex items-center gap-2">
          viLilt
          <span class="text-[9px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-[#8B55FA]/20 text-[#C4B5FD] border border-[#8B55FA]/40">Voice AI</span>
        </span>
        <span class="text-[10px] text-gray-400 font-medium tracking-wide">Talk. Listen. Nothing else.</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden lg:flex items-center gap-7 text-sm font-medium text-gray-300">
      <a href={getLocalePath(locale, '#features')} class="hover:text-white transition-colors">{i.nav.features}</a>
      <a href={getLocalePath(locale, '#personas')} class="hover:text-white transition-colors">{i.nav.personas}</a>
      <a href={getLocalePath(locale, '#models')} class="hover:text-white transition-colors">{i.nav.models}</a>
      <a href={getLocalePath(locale, '#tiers')} class="hover:text-white transition-colors">{i.nav.tiers}</a>
      <a href="https://github.com/viailabs/vililt" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
    </div>

    <!-- Desktop Right: Language Picker + CTA -->
    <div class="hidden md:flex items-center gap-3.5">
      <!-- Language Picker Dropdown -->
      <div class="relative">
        <button id="lang-toggle-desktop" class="flex items-center gap-1.5 text-xs text-gray-300 bg-white/5 border border-white/10 hover:border-[#8B55FA]/50 hover:text-white px-3 py-2 rounded-xl transition-all shadow-sm">
          <svg class="w-3.5 h-3.5 text-[#C4B5FD]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          <span>{localeNames[locale]}</span>
          <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div id="lang-dropdown-desktop" class="absolute right-0 top-full mt-2 bg-[#0E1322] border border-white/10 rounded-2xl shadow-2xl py-2 min-w-[150px] z-50 hidden backdrop-blur-xl">
          {locales.map(loc => (
            <a href={getLocalePath(loc, currentPath)} class={`block px-4 py-2 text-xs transition-colors ${loc === locale ? 'text-[#C4B5FD] font-bold bg-[#8B55FA]/15' : 'text-gray-300 hover:bg-white/5 hover:text-white'}`}>
              {localeNames[loc]}
            </a>
          ))}
        </div>
      </div>

      <!-- TestFlight CTA -->
      <a href="#download" class="px-4 py-2 bg-gradient-to-r from-[#8B55FA] to-[#1FD1F3] hover:opacity-90 text-white text-xs font-semibold rounded-xl transition-all shadow-[0_0_20px_rgba(139,85,250,0.4)] flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        {i.nav.download}
      </a>
    </div>

    <!-- Mobile Menu Trigger -->
    <div class="flex items-center gap-2 md:hidden">
      <button id="lang-toggle-mobile" class="p-2 text-gray-300 hover:text-white rounded-lg bg-white/5 border border-white/10" aria-label="Languages">
        <svg class="w-4 h-4 text-[#C4B5FD]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
      </button>

      <button id="mobile-menu-btn" class="p-2 text-gray-300 hover:text-white rounded-lg bg-white/5 border border-white/10" aria-label="Toggle Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Language Dropdown -->
  <div id="mobile-lang-menu" class="hidden md:hidden px-6 py-3 bg-[#0E1322] border-t border-b border-white/10 flex justify-center gap-4 text-xs font-medium">
    {locales.map(loc => (
      <a href={getLocalePath(loc, currentPath)} class={`px-3 py-1.5 rounded-lg transition-colors ${loc === locale ? 'bg-[#8B55FA] text-white font-bold' : 'text-gray-400 hover:text-white'}`}>
        {localeNames[loc]}
      </a>
    ))}
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden"></div>
  <div id="mobile-drawer" class="fixed top-0 right-0 h-full w-72 bg-[#0E1322] border-l border-white/10 z-50 shadow-2xl translate-x-full transition-transform duration-300 flex flex-col">
    <div class="p-5 border-b border-white/10 flex justify-between items-center">
      <span class="font-extrabold text-white text-lg">viLilt</span>
      <button id="mobile-drawer-close" class="p-2 text-gray-400 hover:text-white"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
    </div>
    <div class="flex-1 p-5 space-y-3 overflow-y-auto">
      <a href={getLocalePath(locale, '#features')} class="block py-2.5 px-3 rounded-xl text-gray-300 hover:bg-white/5 hover:text-white text-sm font-medium">{i.nav.features}</a>
      <a href={getLocalePath(locale, '#personas')} class="block py-2.5 px-3 rounded-xl text-gray-300 hover:bg-white/5 hover:text-white text-sm font-medium">{i.nav.personas}</a>
      <a href={getLocalePath(locale, '#models')} class="block py-2.5 px-3 rounded-xl text-gray-300 hover:bg-white/5 hover:text-white text-sm font-medium">{i.nav.models}</a>
      <a href={getLocalePath(locale, '#tiers')} class="block py-2.5 px-3 rounded-xl text-gray-300 hover:bg-white/5 hover:text-white text-sm font-medium">{i.nav.tiers}</a>
      <a href="https://github.com/viailabs/vililt" target="_blank" rel="noopener noreferrer" class="block py-2.5 px-3 rounded-xl text-gray-300 hover:bg-white/5 hover:text-white text-sm font-medium">GitHub</a>
      
      <hr class="my-4 border-white/10" />
      <p class="px-3 text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">Language / 语言 / 語言</p>
      <div class="space-y-1">
        {locales.map(loc => (
          <a href={getLocalePath(loc, currentPath)} class={`block py-2 px-3 rounded-lg text-xs transition-colors ${loc === locale ? 'bg-[#8B55FA]/20 text-[#C4B5FD] font-bold border border-[#8B55FA]/30' : 'text-gray-400 hover:text-white'}`}>
            {localeNames[loc]}
          </a>
        ))}
      </div>

      <div class="pt-6">
        <a href="#download" class="w-full py-3 bg-gradient-to-r from-[#8B55FA] to-[#1FD1F3] text-white text-center text-xs font-bold rounded-xl block shadow-lg">
          {i.nav.download}
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const langToggleDesktop = document.getElementById('lang-toggle-desktop');
  const langDropdownDesktop = document.getElementById('lang-dropdown-desktop');
  langToggleDesktop?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdownDesktop?.classList.toggle('hidden');
  });
  document.addEventListener('click', () => {
    langDropdownDesktop?.classList.add('hidden');
  });

  const langToggleMobile = document.getElementById('lang-toggle-mobile');
  const mobileLangMenu = document.getElementById('mobile-lang-menu');
  langToggleMobile?.addEventListener('click', () => {
    mobileLangMenu?.classList.toggle('hidden');
  });

  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileBackdrop = document.getElementById('mobile-drawer-backdrop');
  const mobileClose = document.getElementById('mobile-drawer-close');

  function openDrawer() {
    mobileDrawer?.classList.remove('translate-x-full');
    mobileBackdrop?.classList.remove('hidden');
  }
  function closeDrawer() {
    mobileDrawer?.classList.add('translate-x-full');
    mobileBackdrop?.classList.add('hidden');
  }

  mobileBtn?.addEventListener('click', openDrawer);
  mobileClose?.addEventListener('click', closeDrawer);
  mobileBackdrop?.addEventListener('click', closeDrawer);
</script>

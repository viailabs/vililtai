---
import { getLocaleFromUrl, t, getLocalePath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const i = t(locale);
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#070A12] border-t border-white/5 py-14 px-6 sm:px-12 text-center md:text-left z-20 relative">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
    <div>
      <div class="flex items-center justify-center md:justify-start gap-3 mb-3">
        <a href={getLocalePath(locale, '')} class="flex items-center gap-3 hover:opacity-90 transition-opacity">
          <img src="/vililt-logo.png" alt="viLilt Logo" class="w-9 h-9 rounded-xl shadow-[0_0_20px_rgba(139,85,250,0.5)] border border-white/10" />
          <span class="text-2xl font-bold text-white tracking-tight">viLilt</span>
        </a>
        <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded-full bg-[#8B55FA]/15 text-[#C4B5FD] border border-[#8B55FA]/30">Voice AI</span>
      </div>
      <p class="text-gray-400 text-sm max-w-sm">
        {i.footer.tagline} Powered by <a href="https://viai.ai" class="text-white hover:underline" target="_blank" rel="noopener noreferrer">VI AI Inc.</a> and <a href="https://viaiforgood.org" class="text-white hover:underline" target="_blank" rel="noopener noreferrer">viaiforgood.org</a>.
      </p>
    </div>
    
    <div class="flex flex-wrap justify-center gap-8 text-sm">
      <div class="flex flex-col gap-2.5">
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">{i.footer.ecosystem}</span>
        <a href="https://loom.viai.ai" class="text-gray-300 hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">viLoom (Agent AI)</a>
        <a href="https://eight.viai.ai" class="text-gray-300 hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">vi8 (Wellness Rings)</a>
        <a href="https://clock.viai.ai" class="text-gray-300 hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">viClock (Acoustic Focus)</a>
        <a href="https://viai.ai" class="text-gray-300 hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">VI AI Labs</a>
      </div>
      <div class="flex flex-col gap-2.5">
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Product</span>
        <a href={getLocalePath(locale, '#features')} class="text-gray-300 hover:text-white transition-colors">{i.nav.features}</a>
        <a href={getLocalePath(locale, '#personas')} class="text-gray-300 hover:text-white transition-colors">{i.nav.personas}</a>
        <a href={getLocalePath(locale, '#models')} class="text-gray-300 hover:text-white transition-colors">{i.nav.models}</a>
        <a href={getLocalePath(locale, '#tiers')} class="text-gray-300 hover:text-white transition-colors">{i.nav.tiers}</a>
        <a href={getLocalePath(locale, 'privacy')} class="text-gray-300 hover:text-white transition-colors">{i.nav.privacy}</a>
      </div>
      <div class="flex flex-col gap-2.5">
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Community</span>
        <a href="https://github.com/viailabs/vililt" class="text-gray-300 hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:developer@viai.ai" class="text-gray-300 hover:text-white transition-colors">developer@viai.ai</a>
      </div>
    </div>
  </div>
  
  <div class="max-w-6xl mx-auto mt-10 pt-8 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center text-gray-500 text-xs gap-4">
    <p>&copy; {currentYear} {i.footer.rights}</p>
    <p class="text-gray-500">100% On-Device · Zero Data Leaves Your iPhone</p>
  </div>
</footer>

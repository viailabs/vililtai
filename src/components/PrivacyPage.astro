---
import { getLocaleFromUrl, t, getLocalePath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const i = t(locale);
const p = i.privacy_page || {};
---

<div class="relative bg-[#070A12] text-white py-20 px-6 sm:px-12 max-w-4xl mx-auto">
  <div class="mb-12">
    <a href={getLocalePath(locale, '')} class="inline-flex items-center gap-2 text-xs font-semibold text-[#8B55FA] hover:text-[#C4B5FD] transition-colors mb-6">
      {p.back || '← Back to Home'}
    </a>
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">
      {p.title || 'viLilt Privacy Policy'}
    </h1>
    <p class="text-gray-400 text-sm font-mono">
      {p.effective || 'Effective Date: September 2026 · 100% On-Device Commitment'}
    </p>
  </div>

  <div class="space-y-8 text-gray-300 leading-relaxed text-sm">
    <div class="bg-[#0E1322] border border-white/10 rounded-2xl p-6">
      <h2 class="text-lg font-bold text-white mb-2">
        {p.s1_title || '1. Core Principle: Zero Data Leaves Your Device'}
      </h2>
      <p>
        {p.s1_desc || 'viLilt is jointly developed by viaiforgood.org (Nonprofit) and VI AI INC. We believe voice conversation is an intrinsically private human experience. viLilt is engineered from ground zero to execute 100% on-device.'}
      </p>
    </div>

    <div class="bg-[#0E1322] border border-white/10 rounded-2xl p-6">
      <h2 class="text-lg font-bold text-white mb-2">
        {p.s2_title || '2. Speech Recognition & Neural Inference'}
      </h2>
      <p>
        {p.s2_desc || 'Your microphone audio stream is processed directly by Apple iOS on-device Speech APIs and local GGUF models on Apple Silicon. Audio recordings are never uploaded to cloud servers or used for third-party model training.'}
      </p>
    </div>

    <div class="bg-[#0E1322] border border-white/10 rounded-2xl p-6">
      <h2 class="text-lg font-bold text-white mb-2">
        {p.s3_title || '3. Zero Telemetry & Zero Analytics'}
      </h2>
      <p>
        {p.s3_desc || 'viLilt contains no third-party advertising SDKs, tracking frameworks, user profiling telemetry, or surveillance analytics.'}
      </p>
    </div>

    <div class="bg-[#0E1322] border border-white/10 rounded-2xl p-6">
      <h2 class="text-lg font-bold text-white mb-2">
        {p.s4_title || '4. Contact & Security Inquiries'}
      </h2>
      <p>
        {p.s4_desc || 'If you have any questions regarding privacy or local security architecture, contact us at: developer@viai.ai or developer@viaiforgood.org.'}
      </p>
    </div>
  </div>
</div>

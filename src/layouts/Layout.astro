---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromUrl, t } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const i = t(locale);

const { title, description } = Astro.props;
const pageTitle = title || i.site.title;
const desc = description || i.site.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://lilt.viai.ai');
---
<!DOCTYPE html>
<html lang={locale} class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={desc} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="theme-color" content="#8B55FA" />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content="https://lilt.viai.ai/vililt-logo.png" />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content="https://lilt.viai.ai/vililt-logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="bg-[#070A12] text-slate-100 font-['Inter'] antialiased min-h-screen flex flex-col selection:bg-[#8B55FA] selection:text-white">
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
